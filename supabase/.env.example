# ==============================================
# Supabase Edge Functions Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# ==============================================

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Application URL (for tracking links)
APP_URL=https://your-app.com

# ==============================================
# WhatsApp Cloud API Configuration
# ==============================================
# Get these from: https://developers.facebook.com/apps
# Follow setup guide at: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started

# WhatsApp API Base URL
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# WhatsApp API Access Token
# Generate from: Facebook Business Manager → WhatsApp → API Setup
WHATSAPP_API_TOKEN=your-whatsapp-api-token-here

# WhatsApp Phone Number ID
# Find in: WhatsApp Business Account → Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# ==============================================
# Alternative: Twilio WhatsApp API (Optional)
# ==============================================
# If using Twilio instead of WhatsApp Cloud API
# Documentation: https://www.twilio.com/docs/whatsapp

# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==============================================
# Development & Testing
# ==============================================

# Set to true to enable debug logging
DEBUG=false

# Set to true to skip actual WhatsApp sending (for testing)
MOCK_WHATSAPP=false
